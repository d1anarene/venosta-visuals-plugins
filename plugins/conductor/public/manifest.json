{
  "id": "com.venostavisuals.conductor",
  "name": "Conductor",
  "version": "0.1.2",
  "main": "index.html",
  "manifestVersion": 5,
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "requiredPermissions": { "localFileSystem": "fullAccess" },
  "entrypoints": [
    {
      "id": "conductorPanel",
      "type": "panel",
      "label": { "default": "Conductor" },
      "minimumSize": { "width": 280, "height": 400 },
      "maximumSize": { "width": 2000, "height": 3000 },
      "preferredDockedSize": { "width": 380, "height": 720 },
      "preferredFloatingSize": { "width": 420, "height": 760 },
      "icons": [{ "width": 23, "height": 23, "path": "icons/panel.svg", "scale": [1, 2], "theme": ["all"] }]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.svg", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ]
}
