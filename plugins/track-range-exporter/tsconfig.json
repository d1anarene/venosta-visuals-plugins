{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM"],
    "types": ["@adobe/premierepro", "node"]
  },
  "include": ["src/**/*.ts", "ame-companion/src/**/*.ts", "tests/**/*.ts"]
}
